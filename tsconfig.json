{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "types": ["chrome", "node"],
    "typeRoots": ["./types", "./node_modules/@types"]
  },
  "include": [
    "src/background/**/*.js",
    "src/lib/**/*.js",
    "src/pages/options/**/*.js",
    "src/pages/bookmarks/bookmark-overlay.js",
    "src/pages/bookmarks/bookmark-tooltip.js",
    "src/pages/bookmarks/bookmark-webdav-status.js",
    "src/pages/bookmarks/bookmark-edit-menu.js",
    "src/pages/bookmarks/bookmark-appearance-menu.js",
    "src/pages/bookmarks/bookmark-tree-state.js",
    "src/pages/bookmarks/bookmark-tree-render.js",
    "src/pages/bookmarks/bookmark-tree-menu.js",
    "src/pages/bookmarks/bookmark-tree-node-actions.js",
    "src/pages/bookmarks/bookmark-tree-mutations.js",
    "src/pages/bookmarks/bookmark-tree-observers.js",
    "src/pages/bookmarks/bookmark-tree-dnd.js",
    "src/pages/bookmarks/bookmark-tree.js",
    "src/pages/bookmarks/bookmarks.js",
    "src/pages/bookmarks/custom-scrollbar.js",
    "src/pages/bookmarks/notifications.js",
    "src/pages/bookmarks/modals.js",
    "src/pages/bookmarks/favicon-cache.js",
    "tools/**/*.cjs",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}